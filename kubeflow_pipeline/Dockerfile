FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app

CMD ["python", "-c", "from kubeflow_pipeline.pipelines.ecommerce_pipeline import ecommerce_pipeline; print('Pipeline module loaded successfully')"]
